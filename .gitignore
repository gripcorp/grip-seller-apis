# intellij project file
/**/*.iml

# maven build target
/**/target/

# build output
/**/bin/
/**/out/
/**/classes/
/**/build/
/**/dist/

# idea querydsl generated qclass
/**/generated/
/**/generated_tests/

# all hidden files and directories
/**/.*

# logs
/**/*.log

# build-output for airflow
/**/deploy-output

# except .gitignore file
!/.gitignore
!/.github

# mkdocs build output + docs-prep.sh 산출물 (원본: 루트 README/CHANGELOG/GUIDELINE/assets)
/site/
/docs/index.md
/docs/changelog.md
/docs/guideline.md
/docs/assets/
